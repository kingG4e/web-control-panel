# Web Control Panel Environment Configuration
# Copy this file to .env and update the values as needed

# Server Configuration
SERVER_PUBLIC_IP=192.168.1.174
DNS_DEFAULT_IP=192.168.1.174

# Frontend Configuration
REACT_APP_DEFAULT_IP=192.168.1.174
REACT_APP_API_URL=http://192.168.1.174:5000

# Flask Configuration
SECRET_KEY=your-secret-key-here
FLASK_DEBUG=True
FLASK_ENV=development

# Database Configuration
DATABASE_URL=sqlite:///controlpanel.db
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_ROOT_PASSWORD=your-mysql-root-password

# Email Configuration
MAIL_SERVER=localhost
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@localhost

# phpMyAdmin Configuration
PHPMYADMIN_URL=http://192.168.1.174/phpmyadmin
PHPMYADMIN_PATH=/usr/share/phpmyadmin
PHPMYADMIN_ENABLED=True

# Roundcube Configuration
RC_WEBMAIL_URL=http://192.168.1.174/roundcube
RC_BASE_PATH=roundcube

# SSL Configuration
SSL_CERT_PATH=/etc/ssl/certs
SSL_KEY_PATH=/etc/ssl/private
SSL_AUTO_RENEWAL=True

# Nginx Configuration
NGINX_CONFIG_DIR=/etc/nginx/sites-available
NGINX_SITES_ENABLED=/etc/nginx/sites-enabled
NGINX_RELOAD_COMMAND=systemctl reload nginx

# DNS Configuration
BIND_CONFIG_DIR=/etc/bind
BIND_ZONES_DIR=/etc/bind/zones
BIND_RELOAD_COMMAND=systemctl reload bind9
BIND9_DEV_MODE=False

# Security Configuration
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=True
PASSWORD_REQUIRE_LOWERCASE=True
PASSWORD_REQUIRE_DIGITS=True
PASSWORD_REQUIRE_SPECIAL=False
SESSION_TIMEOUT=3600
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=1800

# File Upload Configuration
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216
ALLOWED_EXTENSIONS=txt,pdf,png,jpg,jpeg,gif,zip,tar,gz

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5

# Remote Services Configuration (Optional)
USE_REMOTE_DNS=False
USE_REMOTE_MAIL=False
USE_REMOTE_DATABASE=False

# Remote DNS Configuration
REMOTE_DNS_SERVER=
REMOTE_DNS_PORT=53
REMOTE_DNS_KEY_PATH=

# Remote Mail Configuration
REMOTE_MAIL_SERVER=
REMOTE_MAIL_PORT=587
REMOTE_MAIL_USER=
REMOTE_MAIL_PASSWORD=

# Remote Database Configuration
REMOTE_DATABASE_SERVER=
REMOTE_DATABASE_PORT=3306
REMOTE_DATABASE_USER=
REMOTE_DATABASE_PASSWORD=
REMOTE_DATABASE_NAME=
